# Copy to .env and replace every value before starting Compose.
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_ROOT_USER=groundstack-local-admin
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
LANGFUSE_NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
LANGFUSE_SALT=replace-with-a-different-random-value

# Application settings (the API does not enforce API_KEY yet).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_DB=rag_platform
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=rag_chunks
REDIS_HOST=localhost
REDIS_PORT=6379
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=groundstack-local-admin
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_BUCKET=rag-documents
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LANGFUSE_HOST=http://localhost:3000
API_KEY=replace-this-unused-development-placeholder
LOG_LEVEL=INFO
